{
  "name": "turnity-backend",
  "version": "1.0.0",
  "description": "Backend for Turnity application",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "sam build",
    "deploy": "sam deploy --stack-name turnity-backend-dev --region us-east-1 --confirm-changeset --capabilities CAPABILITY_IAM",
    "local": "sam local start-api --env-vars env.json.example",
    "delete": "sam delete --stack-name turnity-backend-dev --region us-east-1 --no-prompts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0"
  }
}