# ─── Turnity — Environment Variables Template ─────────────────────
# Copy this file to .env.local for local development
# Set real values in AWS Systems Manager Parameter Store or CI/CD secrets
# All VITE_ variables are exposed to the browser bundle — never put secrets here

# ── API Gateway ────────────────────────────────────────────────────
# Base URL of your API Gateway stage
# Format: https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-southeast-1.amazonaws.com/prod

# ── AWS Cognito (if using Cognito for Auth) ────────────────────────
VITE_COGNITO_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── S3 / CloudFront ────────────────────────────────────────────────
# Public CloudFront domain serving uploaded files (avatars, assignment files)
VITE_CDN_BASE_URL=https://dxxxxxxxxxx.cloudfront.net

# ── Feature Flags ─────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DARK_MODE=true

# ── App ───────────────────────────────────────────────────────────
VITE_APP_NAME=Turnity
VITE_APP_ENV=production   # development | staging | production
