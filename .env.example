# ─── Turnity — Environment Variables Template ─────────────────────
# Copy this file to .env.local for local development
# Set real values in AWS Systems Manager Parameter Store or CI/CD secrets
# All VITE_ variables are exposed to the browser bundle — never put secrets here
# TU `Application-Key` must never be placed in this file or anywhere in the frontend bundle

# ── API Gateway ────────────────────────────────────────────────────
# Frontend data mode
# mock = use local frontend mock repository
# api  = call your deployed API Gateway
VITE_DATA_SOURCE=mock

# Base URL of your API Gateway stage
# Format: https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
# Learner Lab usually works best in us-east-1 or us-west-2
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# ── Auth / AWS Cognito (optional later) ────────────────────────────
# In the current frontend flow, the browser should call your backend `/auth/login`.
# That backend can then validate against the TU API and return app tokens + user role.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── S3 / CloudFront ────────────────────────────────────────────────
# Public CloudFront domain serving uploaded files (avatars, assignment files)
VITE_CDN_BASE_URL=https://dxxxxxxxxxx.cloudfront.net

# ── Feature Flags ─────────────────────────────────────────────────
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DARK_MODE=true

# ── App ───────────────────────────────────────────────────────────
VITE_APP_NAME=Turnity
VITE_APP_ENV=development
